# ==========================================
# AssetFlow - Environment Variables Template
# ==========================================
# Copy this file to .env and fill in your values
# Do NOT commit .env to git (use .gitignore)

# ==========================================
# Database Configuration
# ==========================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/assetflow
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=assetflow

# ==========================================
# Security
# ==========================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-key-change-in-production

# ==========================================
# Application
# ==========================================
NODE_ENV=development
PORT=10000

# ==========================================
# Services Configuration
# ==========================================
# Internal service URLs (localhost in development)
INTERNAL_GATEWAY_URL=http://127.0.0.1:3000
GATEWAY_BASE_URL=/api/v1
AUTH_BASE_URL=/auth

# Service URLs
USERS_SERVICE_URL=http://127.0.0.1:3001
ASSETS_SERVICE_URL=http://127.0.0.1:3002
TICKETS_SERVICE_URL=http://127.0.0.1:3003

# ==========================================
# Message Queue (optional)
# ==========================================
DISABLE_RABBITMQ=true
# RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ==========================================
# Logging
# ==========================================
LOG_LEVEL=info

# ==========================================
# CORS & Security Headers
# ==========================================
CORS_ORIGIN=http://localhost:8080
ALLOWED_ORIGINS=localhost:3000,localhost:8080

# ==========================================
# Frontend Configuration
# ==========================================
FRONTEND_PORT=8080

# ==========================================
# API Rate Limiting (optional)
# ==========================================
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
