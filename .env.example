# Configuração do Servidor
PORT=10000

# Configuração do Banco de Dados
# Opção 1: DATABASE_URL (prioritária)
# DATABASE_URL=postgresql://user:password@host:5432/assetflow

# Opção 2: Variáveis individuais
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=assetflow

# Alternativas para Postgres (usado pelo Railway/Fly.io)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=assetflow

# Segurança
JWT_SECRET=your-super-secret-key-change-this-in-production

# RabbitMQ
DISABLE_RABBITMQ=true

# Node Environment
NODE_ENV=development
